# MongoDB (local instance or Atlas connection string)
MONGO_URI=mongodb://localhost:27017
# In docker-compose the API reaches Mongo via the "db" service:
# MONGO_URI=mongodb://db:27017
MONGO_DB=issue_tracker

# Secrets — generate your own values; never commit the real .env
SECRET_KEY=change-me-long-random-string
JWT_SECRET_KEY=change-me-long-random-string

# Token lifetimes (seconds)
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800
